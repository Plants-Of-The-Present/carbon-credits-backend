# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres123@localhost:5433/carbon_credits?schema=public"
POSTGRES_DB=carbon_credits
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# JWT
JWT_SECRET=your_super_secure_jwt_secret_here_change_this_in_production
JWT_EXPIRE=7d
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# File upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Frontend
FRONTEND_URL=http://localhost:3000

# API Keys (para integrações futuras)
GOOGLE_MAPS_API_KEY=your_google_maps_key
BLOCKCHAIN_API_KEY=your_blockchain_api_key

# Docker specific (used in docker-compose)
# These will override the above when running in containers